# Supply Chain Forecasting Agent - Environment Variables
# Copy this file to .env and fill in your actual values
# On Linux/Mac: cp env.example .env
# On Windows: copy env.example .env

# Required: Google API Key for RAG and LLM features
GOOGLE_API_KEY=your_google_api_key_here

# Optional: HuggingFace Hub API Token (for HuggingFace models/embeddings)
# Get your token from: https://huggingface.co/settings/tokens
HUGGINGFACEHUB_API_TOKEN=your_huggingface_token_here

# Optional: API Configuration (defaults work fine)
API_HOST=0.0.0.0
API_PORT=8000

# Optional: Streamlit Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_SERVER_HEADLESS=true

# Optional: Backend URL (for frontend to connect)
BACKEND_URL=http://localhost:8000

# Optional: Logging
LOG_LEVEL=INFO

